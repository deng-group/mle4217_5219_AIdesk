# Copy this file to /etc/mle-course-helper.env on the server.
# Keep real API keys out of git.

# Flask/Gunicorn
PORT=5055
PYTHONUNBUFFERED=1
HF_HOME=/srv/mle-course-helper/backend/.cache/huggingface
TRANSFORMERS_CACHE=/srv/mle-course-helper/backend/.cache/huggingface

# Provider selection is automatic in web_app/app.py:
# - Anthropic-compatible provider if ANTHROPIC_AUTH_TOKEN or ANTHROPIC_API_KEY is set.
# - Gemini if GEMINI_API_KEY or GOOGLE_API_KEY is set.
# - dry_run if no provider key is set.

# Anthropic-compatible endpoint, including the local relay used in testing.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=replace-me
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Gemini
# GEMINI_API_KEY=replace-me
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=gpt-4.1-mini
